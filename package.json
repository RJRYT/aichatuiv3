{
  "name": "nemotron-chat-monorepo",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace @nemotron/server\" \"npm run dev --workspace @nemotron/client\"",
    "build": "npm run build --workspace @nemotron/client",
    "start": "npm run start --workspace @nemotron/server",
    "start:build": "npm run build && npm start",
    "start:api": "npm run start --workspace @nemotron/server",
    "test": "node --test apps/server/test/*.test.js",
    "migrate:users": "node apps/server/scripts/migrate-users.js",
    "sandbox:check": "npm run sandbox:check --workspace @nemotron/server",
    "sandbox:smoke": "npm run sandbox:smoke --workspace @nemotron/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expr-eval": "^2.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.1.7",
    "@vercel/sandbox": "3.9.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
