# NVIDIA NIM
NVIDIA_API_KEY=nvapi-your-key-here

# MongoDB is required for OAuth accounts, memories and persistent chat history
MONGODB_URI=mongodb://127.0.0.1:27017/nemotron_agent_lab


PORT=4000
NODE_ENV=development
SERVE_STATIC=true
AUTH_REQUIRED=true
SESSION_SECRET=replace-with-a-long-random-secret
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Tavily web search (free Researcher tier: 1,000 credits/month)
TAVILY_API_KEY=tvly-your-key-here

# OAuth credentials. Configure callback URLs exactly as below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback

# Backend-managed prompts (not exposed in the UI)
SYSTEM_PROMPT=You are Nemotron Agent, the AI assistant powering Nemotron Agent Lab. You were created by Robin J R (RJRYT). Be accurate, secure, transparent, and use registered tools when useful.
INITIAL_INSTRUCTIONS=Be practical, direct, and clear. Use tools when they improve the answer.

# Vercel Sandbox (required for Python execution on non-Vercel hosts)
# External Node.js hosting: create a Vercel access token and provide the team/project IDs.
# Vercel-hosted deployments can use project OIDC instead of an access token.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Optional: Vercel Sandbox region, e.g. bom1 (Mumbai), sin1, iad1, fra1
VERCEL_SANDBOX_REGION=
# Python image includes Python 3.14, pip, venv and uv.
VERCEL_SANDBOX_IMAGE=vercel/sandbox/python:3.14
# Use 1, 2 or 4 vCPUs; 1 is the economical Hobby default.
VERCEL_SANDBOX_VCPUS=1
# Default 5 minutes. Hobby allows up to 45 minutes per session.
VERCEL_SANDBOX_TIMEOUT_MS=300000
VERCEL_SANDBOX_PACKAGE_INSTALL_TIMEOUT_MS=180000
# public = public internet allowed, private/reserved subnets blocked.
# deny-all disables all sandbox egress (including pip installs and web requests).
VERCEL_SANDBOX_NETWORK_MODE=public
# Conversation sandbox snapshots expire after this many idle days (1-30).
VERCEL_SANDBOX_SNAPSHOT_TTL_DAYS=7
