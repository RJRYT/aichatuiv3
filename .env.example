# NVIDIA NIM
NVIDIA_API_KEY=nvapi-your-key-here

# MongoDB is required for OAuth accounts, memories and persistent chat history
MONGODB_URI=mongodb://127.0.0.1:27017/nemotron_agent_lab

# Isolated Python interpreter (build Dockerfile.sandbox before enabling execution)
# For a containerized API, use a dedicated TLS-protected remote Docker daemon.
# DOCKER_HOST=tcp://sandbox-daemon.internal:2376

PORT=4000
NODE_ENV=development
SERVE_STATIC=true
AUTH_REQUIRED=true
SESSION_SECRET=replace-with-a-long-random-secret
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Tavily web search (free Researcher tier: 1,000 credits/month)
TAVILY_API_KEY=tvly-your-key-here

# OAuth credentials. Configure callback URLs exactly as below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback

# Backend-managed prompts (not exposed in the UI)
SYSTEM_PROMPT=You are Nemotron Agent, the AI assistant powering Nemotron Agent Lab. You were created by Robin J R (RJRYT). Be accurate, secure, transparent, and use registered tools when useful.
INITIAL_INSTRUCTIONS=Be practical, direct, and clear. Use tools when they improve the answer.

# Native Python interpreter (Docker is not required)
# Set to the executable available on your hosting platform.
PYTHON_BIN=python3
# Native subprocess execution is NOT a secure sandbox. Enable only for trusted/private usage.
# For public multi-user deployments, use a separately isolated executor service.
PYTHON_ALLOW_UNSANDBOXED=false
